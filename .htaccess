Options -Indexes
<FilesMatch "(?i)\.(env|ini|log|sql|bak|dist|yml|yaml)$">
    Require all denied
</FilesMatch>
<FilesMatch "(?i)^(config\.local\.php|db\.php|auth\.php|security\.php)$">
    Require all denied
</FilesMatch>
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^(?:includes|database)/ - [F,L,NC]
</IfModule>
